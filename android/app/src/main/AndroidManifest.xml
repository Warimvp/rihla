<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Rihla s'apprend 100 % hors ligne : le contenu, les polices, les photos et les progrès sont dans
      l'application ou sur le téléphone, et la page est servie par le serveur LOCAL de Capacitor
      (https://localhost, dans le processus). Depuis la 1.2, UNE seule fonction parle à un serveur : le jeu
      en ligne (la Course, l'adversaire au hasard, les classements). Il est éteint par défaut ; rien ne part
      avant que le voyageur ait lu et accepté l'écran « Jouer en ligne ? » (src/lib/enligne.js), et ce
      qui part se limite à un pseudonyme, des scores et un identifiant tiré au hasard (page de
      confidentialité, fiche « Sécurité des données »). D'où l'autorisation INTERNET, déclarée plus bas
      avec la fiche, la politique et la barrière scripts/verifier-android.mjs, qui n'admet qu'UNE adresse.

      allowBackup="false" ET dataExtractionRules : le progrès (localStorage de la WebView) ne part
      pas dans une sauvegarde Google Drive — « rien ne quitte votre téléphone » (hors jeu en ligne
      activé) reste exact. La sauvegarde manuelle (Réglages → Aide et sauvegarde) reste le moyen de
      changer de téléphone. Contrôlé par scripts/verifier-android.mjs.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
      Autorisations de l'application, et ce qui les justifie. Toute autorisation nouvelle fait
      échouer scripts/verifier-android.mjs : l'ajouter là-bas exige de la justifier aussi.

      Posées par le greffon de notifications locales (rappel quotidien, OPT-IN, Réglages) :
      · POST_NOTIFICATIONS   — afficher le rappel ; demandée seulement quand on l'active ;
      · RECEIVE_BOOT_COMPLETED — reprogrammer le rappel après un redémarrage du téléphone ;
      · WAKE_LOCK            — réveiller le téléphone le temps d'afficher le rappel.

      RETIRÉE : SCHEDULE_EXACT_ALARM. Le greffon la pose et demanderait à l'utilisateur d'ouvrir
      le réglage « Alarmes et rappels » ; un rappel de leçon à 19 h n'a pas besoin de la minute
      exacte (`isExactNotification: false`, src/lib/rappel.js), et Google Play réserve cette
      autorisation aux applications d'alarme et de calendrier.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />

    <!--
      INTERNET (1.2) — le jeu en ligne, et rien d'autre : fetch + WebSocket vers l'UNIQUE serveur de
      la barrière (https, jamais en clair : usesCleartextTraffic reste refusé). Sans l'adresse du serveur
      dans la build, cette ligne n'a pas lieu d'être : la barrière refuse l'une sans l'autre.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
